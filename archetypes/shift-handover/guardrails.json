{
  "name": "shift-handover",
  "data-class": "internal-personal",
  "allowed-fields": ["incident_id", "venue_key", "date_key", "category", "severity", "resolution_minutes", "escalated"],
  "never-read-fields": ["guest_name", "guest_email", "staff_medical_notes", "incident_investigation_notes"],
  "output": {
    "type": "lines",
    "count": 3,
    "max_words_per_line": 40,
    "prohibited_patterns": ["guest_name", "email_address", "phone_number", "credit_card", "external_url"],
    "requires": ["line1", "line2", "line3"],
    "allowed_name_patterns": ["Shift handover", "What happened"]
  },
  "policy": {
    "enabled": false
  }
}

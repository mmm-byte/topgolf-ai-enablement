{
  "name": "topgolf-ai-enablement",
  "version": "5.0.0",
  "private": true,
  "description": "AI enablement engineering portfolio: archetypes, governed connectors, guardrails and drift monitoring for a gated AI-SDLC pipeline.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "data": "python3 scripts/build_pipeline.py",
    "test": "python3 -m pytest tests -q",
    "guardrails": "python3 -m security.guardrails.guardrails --self-test",
    "adversarial": "python3 -m security.adversarial.run_suite",
    "health": "python3 -m monitoring.health_report",
    "catalog": "python3 -m monitoring.validate_catalog",
    "secrets": "python3 -m security.guardrails.secrets_scan"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "14.2.33",
    "@next/swc-darwin-x64": "14.2.33",
    "@next/swc-linux-arm64-gnu": "14.2.33",
    "@next/swc-linux-arm64-musl": "14.2.33",
    "@next/swc-linux-x64-gnu": "14.2.33",
    "@next/swc-linux-x64-musl": "14.2.33",
    "@next/swc-win32-arm64-msvc": "14.2.33",
    "@next/swc-win32-ia32-msvc": "14.2.33",
    "@next/swc-win32-x64-msvc": "14.2.33"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  },
  "engines": {
    "node": ">=20"
  }
}

-- FIELDIQ reusable measure starters. Align relationships and table names before publishing.
-- These measures have not been deployed or performance-tested in a Power BI model.

Service Revenue :=
CALCULATE(
    SUM(fact_work_order[service_revenue]),
    fact_work_order[status] = "Closed"
)

Open Backlog :=
CALCULATE(
    COUNTROWS(fact_work_order),
    fact_work_order[status] <> "Closed"
)

Closed Work Orders :=
CALCULATE(
    COUNTROWS(fact_work_order),
    fact_work_order[status] = "Closed"
)

Average Days to Close :=
CALCULATE(
    AVERAGE(fact_work_order[days_open]),
    fact_work_order[status] = "Closed"
)

Parts Fill Rate :=
DIVIDE(
    SUM(fact_parts_order[qty_fulfilled]),
    SUM(fact_parts_order[qty_requested])
)

Modeled Rental Revenue :=
SUM(fact_rental_contract[modeled_rental_revenue])

Rented Asset Days :=
SUM(fact_fleet_day[is_rented])

Available Asset Days :=
SUM(fact_fleet_day[is_available])

Fleet Utilization :=
DIVIDE([Rented Asset Days], [Available Asset Days])

-- Caveat: fact_fleet_day assumes every asset-day is available. Add maintenance,
-- repair, and out-of-service status before treating this as an operational KPI.
